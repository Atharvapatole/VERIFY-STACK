# ==========================================
# VERIFY STACK - ENVIRONMENT CONFIGURATION
# ==========================================

# Supabase Public Configuration (Client & SSR)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder"

# Supabase Server-Only Privileged Key (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder"

# Base URL of the deployment (used for webhook callback URLs & links)
# In development: http://localhost:3000
# In production: https://verify.yourdomain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cryptographic Keys (Hex-encoded 32-byte strings = 64 hex characters)
# Generate via: openssl rand -hex 32 or node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# Used for AES-256-GCM encryption of stored Meta Access Tokens & App Secrets
INTEGRATION_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Used for HMAC-SHA256 hashing of API Keys before storage (vs_live / vs_test)
API_KEY_HASH_SECRET="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Used for keyed HMAC hashing of 6-digit OTP codes (prevents rainbow table attacks against low-entropy codes)
OTP_HMAC_SECRET="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Admin Access Control (Comma-separated list of authorized email addresses)
ADMIN_EMAIL_ALLOWLIST="admin@yourdomain.com,security@yourdomain.com"

# Optional Meta Graph API Version Override (defaults to v22.0)
META_GRAPH_API_VERSION="v22.0"

# Rate Limiting Configuration (Per Minute)
RATE_LIMIT_OTP_SEND_PER_PHONE=3
RATE_LIMIT_OTP_SEND_PER_IP=10
RATE_LIMIT_OTP_VERIFY_PER_CHALLENGE=5
